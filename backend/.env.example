# Never commit your real .env file or production secrets.
NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurent_app_db

# Set ADMIN_PASSWORD before the first production startup to create the
# initial administrator account. Existing administrator accounts are preserved.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@restaurant.local
ADMIN_PASSWORD=

# Replace this placeholder with a random secret of at least 32 characters.
JWT_SECRET=replace_with_your_own_secret
JWT_EXPIRES_IN=1d
